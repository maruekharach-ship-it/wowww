-- ฟังก์ชันสร้างปุ่ม Toggle (แดง/เขียว/ขาว)
local function CreateToggle(name, isMultiFunction, callback)
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(1, 0, 0, 35)
    Button.Text = name
    Button.Font = Enum.Font.GothamBold
    Button.TextSize = 14
    Button.Parent = MainFrame
    
    local state = false
    -- ตั้งสีเริ่มต้น: ถ้าเป็นมัลติฟังก์ชันให้เป็นสีขาว ถ้าเป็นเปิด/ปิดปกติให้เป็นสีแดง (ปิด)
    Button.BackgroundColor3 = isMultiFunction and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 50, 50)
    Button.TextColor3 = isMultiFunction and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)

    Button.MouseButton1Click:Connect(function()
        if isMultiFunction then
            callback("Multi") -- ฟังก์ชันที่มีหลายตัวเลือกในปุ่มเดียว
        else
            state = not state
            Button.BackgroundColor3 = state and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
            callback(state)
        end
    end)
end

-- ฟังก์ชันสร้างช่องใส่ตัวเลข (TextBox)
local function CreateInput(name, placeholder, callback)
    local InputFrame = Instance.new("Frame")
    InputFrame.Size = UDim2.new(1, 0, 0, 35)
    InputFrame.BackgroundTransparency = 1
    InputFrame.Parent = MainFrame

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0.6, 0, 1, 0)
    Label.Text = " " .. name
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.BackgroundTransparency = 1
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = InputFrame

    local TextBox = Instance.new("TextBox")
    TextBox.Size = UDim2.new(0.35, 0, 0.8, 0)
    TextBox.Position = UDim2.new(0.6, 0, 0.1, 0)
    TextBox.PlaceholderText = placeholder
    TextBox.Text = ""
    TextBox.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    TextBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    TextBox.Parent = InputFrame

    TextBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            callback(tonumber(TextBox.Text) or 0)
        end
    end)
end

